#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 3 ]]; then
  echo "Usage: gm-fallback-append <type> <text> <owner> [reason]" >&2
  exit 1
fi

TYPE="$1"
TEXT="$2"
OWNER="$3"
REASON="${4:-GrayMatter write fallback}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${ROOT_DIR:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
SPOOL="${GRAYMATTER_FALLBACK_SPOOL:-${ROOT_DIR}/memory/graymatter-fallback.json}"
LOCK_DIR="${GRAYMATTER_FALLBACK_LOCK_DIR:-${SPOOL}.lock}"
NOW="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

command -v jq >/dev/null 2>&1 || {
  echo "gm-fallback-append requires jq" >&2
  exit 1
}

mkdir -p "$(dirname "$SPOOL")"

acquire_lock() {
  local attempt=0
  local owner=""
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$LOCK_DIR/pid"
      rmdir "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
    if (( attempt >= 100 )); then
      echo "gm-fallback-append: fallback queue is busy" >&2
      exit 1
    fi
    attempt=$((attempt + 1))
    sleep 0.02
  done
  printf '%s\n' "$$" >"$LOCK_DIR/pid"
}

release_lock() {
  local owner=""
  owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
  if [[ "$owner" == "$$" ]]; then
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
  fi
}

acquire_lock
trap release_lock EXIT
TMP="${SPOOL}.$$"

if [[ -f "$SPOOL" ]]; then
  jq -n \
    --slurpfile current "$SPOOL" \
    --arg now "$NOW" \
    --arg type "$TYPE" \
    --arg text "$TEXT" \
    --arg owner "$OWNER" \
    --arg reason "$REASON" '
      def normalized:
        ($current[0] // null) as $data
        | if ($data | type) == "object" then
            $data | .items = ((.items // []) | if type == "array" then . else [] end)
          elif ($data | type) == "array" then
            {timestamp:$now, source:"chat", status:"pending_replay", items:$data}
          else
            {timestamp:$now, source:"chat", status:"pending_replay", items:[]}
          end;
      normalized
      | .timestamp = $now
      | .source = (.source // "chat")
      | .status = "pending_replay"
      | .items =
        ((.items // []) as $items
        | if any($items[]?; .type == $type and .text == $text and .owner == $owner) then
            $items
            | map(
                if .type == $type and .text == $text and .owner == $owner then
                  .reason = $reason
                  | .lastSeenAt = $now
                  | .firstSeenAt = (.firstSeenAt // .timestamp // $now)
                  | .duplicateCount = ((.duplicateCount // 0) + 1)
                else
                  .
                end
              )
          else
            $items + [{type:$type, text:$text, owner:$owner, reason:$reason, firstSeenAt:$now, lastSeenAt:$now, duplicateCount:0}]
          end)
    ' >"$TMP"
else
  jq -n \
    --arg now "$NOW" \
    --arg type "$TYPE" \
    --arg text "$TEXT" \
    --arg owner "$OWNER" \
    --arg reason "$REASON" \
    '{timestamp:$now, source:"chat", status:"pending_replay", items:[{type:$type, text:$text, owner:$owner, reason:$reason, firstSeenAt:$now, lastSeenAt:$now, duplicateCount:0}]}' >"$TMP"
fi

mv "$TMP" "$SPOOL"
