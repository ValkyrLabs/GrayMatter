#!/usr/bin/env bash

# Shared named-login profile helpers. Profile files contain only local routing
# metadata. Hosted sessions remain in the platform vault; hosted passwords are
# never persisted. Local-only profile passwords remain in mode-0600 files.

gm_profile_state_dir() {
  printf '%s\n' "${GRAYMATTER_STATE_DIR:-${HOME:-.}/.graymatter}"
}

gm_profile_registry_file() {
  printf '%s\n' "${GRAYMATTER_PROFILES_FILE:-$(gm_profile_state_dir)/profiles.json}"
}

gm_profile_hash_text() {
  local thor_value="${1:-}"
  if command -v sha256sum >/dev/null 2>&1; then
    printf '%s' "$thor_value" | sha256sum | awk '{print $1}'
  else
    printf '%s' "$thor_value" | shasum -a 256 | awk '{print $1}'
  fi
}

gm_profile_account_fingerprint_value() {
  local thor_hash=""
  thor_hash="$(gm_profile_hash_text "${1:-}")"
  printf 'sha256:%s\n' "${thor_hash:0:12}"
}

gm_profile_name_valid() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

gm_profile_require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "GrayMatter named profiles require jq." >&2
    return 1
  fi
}

gm_profile_registry_valid() {
  local thor_file="${1:-$(gm_profile_registry_file)}"
  [[ -f "$thor_file" ]] || return 1
  jq -e '
    .version == 1
    and (.mode == "legacy" or .mode == "single" or .mode == "blend")
    and (.profiles | type == "object")
    and (.blendProfiles | type == "array")
  ' "$thor_file" >/dev/null 2>&1
}

gm_profile_record_json() {
  local thor_name="${1:-}"
  local thor_file="${2:-$(gm_profile_registry_file)}"
  gm_profile_name_valid "$thor_name" || return 1
  gm_profile_registry_valid "$thor_file" || return 1
  jq -ce --arg name "$thor_name" '.profiles[$name] // empty' "$thor_file"
}

gm_profile_configured() {
  gm_profile_record_json "${1:-}" >/dev/null 2>&1
}

gm_profile_normalize_list() {
  local thor_raw="${1:-}"
  printf '%s\n' "$thor_raw" \
    | tr ',[:space:]' '\n\n' \
    | awk 'NF && !seen[$0]++ {print}'
}

gm_profile_selected_names() {
  local thor_names="${GRAYMATTER_BLEND_PROFILES:-${GRAYMATTER_PROFILES:-}}"
  gm_profile_normalize_list "$thor_names"
}

gm_profile_is_blended() {
  [[ "${GRAYMATTER_PROFILE_MODE:-}" == "blend" && -n "${GRAYMATTER_BLEND_PROFILES:-}" ]]
}

gm_profile_assert_single() {
  local thor_operation="${1:-This operation}"
  if gm_profile_is_blended; then
    echo "${thor_operation} requires one active GrayMatter profile." >&2
    echo "Run 'scripts/gm-profile use <name>' or set GRAYMATTER_PROFILE=<name> for this command." >&2
    return 64
  fi
}

gm_profile_keychain_item_exists() {
  local thor_account="${1:-}"
  local thor_service="${2:-}"
  [[ -n "$thor_account" && -n "$thor_service" ]] || return 1
  command -v security >/dev/null 2>&1 || return 1
  security find-generic-password -a "$thor_account" -s "$thor_service" >/dev/null 2>&1
}

gm_profile_keychain_value() {
  local thor_account="${1:-}"
  local thor_service="${2:-}"
  [[ -n "$thor_account" && -n "$thor_service" ]] || return 1
  command -v security >/dev/null 2>&1 || return 1
  security find-generic-password -a "$thor_account" -s "$thor_service" -w 2>/dev/null
}

gm_profile_username_value() {
  local thor_record="${1:-}"
  jq -r '.username // empty' <<<"$thor_record"
}

gm_profile_auth_material_present() {
  local thor_name="${1:-}"
  local thor_record=""
  local thor_account=""
  local thor_service=""
  thor_record="$(gm_profile_record_json "$thor_name")" || return 1
  if [[ "$(jq -r '.kind // "hosted"' <<<"$thor_record")" == "local" ]]; then
    local thor_password_file=""
    thor_password_file="$(jq -r '.passwordFile // empty' <<<"$thor_record")"
    [[ -n "$thor_password_file" && -f "$thor_password_file" && -r "$thor_password_file" ]]
    return
  fi
  thor_account="$(gm_profile_username_value "$thor_record")"
  thor_service="$(jq -r '.keychainService' <<<"$thor_record")"
  [[ -n "$thor_account" && "$thor_account" != "null" ]] || return 1
  gm_profile_keychain_item_exists "$thor_account" "$thor_service"
}

gm_profile_token_present() {
  local thor_name="${1:-}"
  local thor_record=""
  local thor_account=""
  local thor_service=""
  thor_record="$(gm_profile_record_json "$thor_name")" || return 1
  if [[ "$(jq -r '.kind // "hosted"' <<<"$thor_record")" == "local" ]]; then
    local thor_password_file=""
    thor_password_file="$(jq -r '.passwordFile // empty' <<<"$thor_record")"
    [[ -n "$thor_password_file" && -f "$thor_password_file" && -r "$thor_password_file" ]]
    return
  fi
  thor_account="$(gm_profile_username_value "$thor_record")"
  thor_service="$(jq -r '.keychainService' <<<"$thor_record")"
  [[ -n "$thor_account" && "$thor_account" != "null" ]] || return 1
  gm_profile_keychain_item_exists "$thor_account" "$thor_service"
}

gm_profile_apply() {
  if [[ "${GRAYMATTER_PROFILE_RESOLVED:-false}" == "true" ]]; then
    return 0
  fi
  export GRAYMATTER_PROFILE_RESOLVED=true

  local thor_file=""
  local thor_requested_single="${GRAYMATTER_PROFILE:-}"
  local thor_requested_blend="${GRAYMATTER_PROFILES:-}"
  local thor_mode="legacy"
  local thor_selected=""
  local thor_blend=""
  local thor_record=""
  local thor_name=""
  local thor_count=0

  thor_file="$(gm_profile_registry_file)"
  if [[ -z "$thor_requested_single" && -z "$thor_requested_blend" && ! -f "$thor_file" ]]; then
    export GRAYMATTER_PROFILE_MODE=legacy
    return 0
  fi

  gm_profile_require_jq || return 1
  if [[ -f "$thor_file" ]] && ! gm_profile_registry_valid "$thor_file"; then
    echo "GrayMatter profile registry is invalid: ${thor_file}" >&2
    return 65
  fi

  if [[ -n "$thor_requested_single" ]]; then
    thor_mode="single"
    thor_selected="$thor_requested_single"
  elif [[ -n "$thor_requested_blend" ]]; then
    thor_mode="blend"
    thor_blend="$thor_requested_blend"
  elif [[ -f "$thor_file" ]]; then
    thor_mode="$(jq -r '.mode // "legacy"' "$thor_file")"
    thor_selected="$(jq -r '.activeProfile // empty' "$thor_file")"
    thor_blend="$(jq -r '.blendProfiles // [] | join(",")' "$thor_file")"
  fi

  case "$thor_mode" in
    legacy)
      export GRAYMATTER_PROFILE_MODE=legacy
      return 0
      ;;
    single)
      if ! gm_profile_name_valid "$thor_selected"; then
        echo "Invalid GrayMatter profile name: ${thor_selected:-empty}" >&2
        return 64
      fi
      thor_record="$(gm_profile_record_json "$thor_selected" "$thor_file")" || {
        echo "GrayMatter profile '${thor_selected}' is not configured." >&2
        echo "Run 'scripts/gm-profile list' or add it with 'scripts/gm-profile add ${thor_selected}'." >&2
        return 4
      }
      export GRAYMATTER_PROFILE_MODE=single
      export GRAYMATTER_ACTIVE_PROFILE="$thor_selected"
      export GRAYMATTER_USERNAME="$(jq -r '.username' <<<"$thor_record")"
      export VALKYR_USERNAME="$GRAYMATTER_USERNAME"
      export VALKYR_API_BASE="$(jq -r '.apiBase' <<<"$thor_record")"
      if [[ "$(jq -r '.kind // "hosted"' <<<"$thor_record")" == "local" ]]; then
        local thor_password_file=""
        thor_password_file="$(jq -r '.passwordFile // empty' <<<"$thor_record")"
        [[ -n "$thor_password_file" && -r "$thor_password_file" ]] || {
          echo "GrayMatter local profile '${thor_selected}' has no readable credential file." >&2
          echo "Run 'scripts/gm-profile login ${thor_selected}' to repair it." >&2
          return 4
        }
        export GRAYMATTER_LIGHT_MODE=true
        export GRAYMATTER_LIGHT_USERNAME="$GRAYMATTER_USERNAME"
        export GRAYMATTER_LIGHT_PASSWORD="$(<"$thor_password_file")"
        unset VALKYR_KEYCHAIN_SERVICE VALKYR_USERNAME_KEYCHAIN_SERVICE VALKYR_PASSWORD_KEYCHAIN_SERVICE
        unset VALKYR_AUTH_TOKEN VALKYR_JWT_SESSION VALKYR_AUTH
        return 0
      fi
      unset GRAYMATTER_LIGHT_MODE GRAYMATTER_LIGHT_USERNAME GRAYMATTER_LIGHT_PASSWORD
      export VALKYR_KEYCHAIN_SERVICE="$(jq -r '.keychainService' <<<"$thor_record")"
      export VALKYR_USERNAME_KEYCHAIN_SERVICE="${VALKYR_KEYCHAIN_SERVICE}_USERNAME"
      export VALKYR_PASSWORD_KEYCHAIN_SERVICE="${VALKYR_KEYCHAIN_SERVICE}_PASSWORD"
      unset VALKYR_AUTH_TOKEN VALKYR_JWT_SESSION VALKYR_AUTH
      return 0
      ;;
    blend)
      while IFS= read -r thor_name; do
        [[ -n "$thor_name" ]] || continue
        if ! gm_profile_name_valid "$thor_name" || ! gm_profile_configured "$thor_name"; then
          echo "GrayMatter blended profile '${thor_name}' is not configured." >&2
          echo "Run 'scripts/gm-profile list' and select configured profile names." >&2
          return 4
        fi
        thor_blend="${thor_blend:+${thor_blend},}${thor_name}"
        thor_count=$((thor_count + 1))
      done < <(gm_profile_normalize_list "${GRAYMATTER_PROFILES:-$(jq -r '.blendProfiles // [] | join(",")' "$thor_file")}")
      if (( thor_count < 2 )); then
        echo "GrayMatter blended mode requires at least two configured profiles." >&2
        return 64
      fi
      # The loop appends to the source value; normalize once more so the
      # exported order is stable and duplicates are removed.
      thor_blend="$(gm_profile_normalize_list "$thor_blend" | awk 'NF && !seen[$0]++' | paste -sd, -)"
      export GRAYMATTER_PROFILE_MODE=blend
      export GRAYMATTER_BLEND_PROFILES="$thor_blend"
      unset GRAYMATTER_ACTIVE_PROFILE GRAYMATTER_USERNAME VALKYR_USERNAME
      unset VALKYR_AUTH_TOKEN VALKYR_JWT_SESSION VALKYR_AUTH
      return 0
      ;;
    *)
      echo "Unsupported GrayMatter profile mode: ${thor_mode}" >&2
      return 65
      ;;
  esac
}

gm_profile_federated_exec_json() {
  local thor_operation="${1:-read}" thor_command="${2:-}"
  shift 2
  gm_profile_require_jq || return 1
  gm_profile_is_blended || return 64
  [[ -n "$thor_command" ]] || return 64
  local thor_dir thor_name thor_authority thor_expected='' thor_data thor_refs thor_receipt thor_path
  local thor_results='[]' thor_requested='[]' thor_authorities='[]' thor_count=0
  local thor_script_dir
  thor_script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  thor_dir="$(mktemp -d "${TMPDIR:-/tmp}/graymatter-federation.XXXXXX")"
  chmod 700 "$thor_dir"

  # Confirm the same API-confirmed actor and physical organization before any
  # source body is fetched. Profile names/fingerprints are routing labels only.
  while IFS= read -r thor_name; do
    [[ -n "$thor_name" ]] || continue
    if ! thor_authority="$(gm_profile_child "$thor_name" "${thor_script_dir}/gm-source-authority" 2>/dev/null)"; then
      rm -rf "$thor_dir"
      echo 'GrayMatter blend denied: authenticated source authority is missing.' >&2
      return 64
    fi
    if [[ -n "$thor_expected" ]] && ! jq -e --argjson expected "$thor_expected" '. == $expected' <<<"$thor_authority" >/dev/null; then
      rm -rf "$thor_dir"
      echo 'GrayMatter blend denied: profiles do not share an authenticated actor and organization. Use the canonical authorized retrieval-domain broker for cross-domain composition.' >&2
      return 64
    fi
    thor_expected="$thor_authority"
    thor_authorities="$(jq -c --arg profile "$thor_name" --argjson authority "$thor_authority" '. + [{profile:$profile,authority:$authority}]' <<<"$thor_authorities")"
    thor_requested="$(jq -c --arg name "$thor_name" '. + [$name]' <<<"$thor_requested")"
  done < <(gm_profile_selected_names)

  while IFS= read -r thor_name; do
    [[ -n "$thor_name" ]] || continue
    if ! gm_profile_child "$thor_name" "$thor_command" "$@" >"$thor_dir/source.json" 2>"$thor_dir/error"         || ! jq -e . "$thor_dir/source.json" >/dev/null 2>&1; then
      rm -rf "$thor_dir"
      echo 'GrayMatter blend denied: a source read failed; no partial evidence is released.' >&2
      return 64
    fi
    thor_data="$(jq -c . "$thor_dir/source.json")"
    thor_path="${2:-}"
    thor_path="${thor_path#/}"
    thor_receipt='null'
    if [[ "$thor_path" == MemoryEntry/stats || "$thor_path" == api-docs || "$thor_path" == auth/me         || "$thor_path" == tenant-schemas/preflight/graymatter_status* ]]; then
      : # Pure read-only metadata; source identity has already been confirmed.
    elif [[ "$thor_path" == MemoryEntry || "$thor_path" == MemoryEntry/query || "$thor_path" == MemoryEntry/* ]]; then
      if ! thor_refs="$(jq -ce '
        (if type == "array" then .
          elif (.items? | type) == "array" then .items
          elif (.results? | type) == "array" then .results
          elif (.content? | type) == "array" then .content
          elif type == "object" and (.id? | type) == "string" then [.] else error("Missing source references") end)
        | if length <= 50 and all(.[]; (.id | type) == "string")
          then map({id:.id,type:"com.valkyrlabs.model.MemoryEntry"}) | unique
          else error("Unbounded or unattributed source records") end' <<<"$thor_data")"; then
        rm -rf "$thor_dir"
        echo 'GrayMatter blend denied: source attribution is missing or exceeds the bound.' >&2
        return 64
      fi
      if [[ "$thor_refs" != '[]' ]]; then
        local thor_encoded
        thor_encoded="$(jq -rn --arg sources "$thor_refs" '$sources | @uri')"
        if ! thor_receipt="$(gm_profile_child "$thor_name" "$thor_command" GET             "tenant-schemas/preflight/graymatter_status?operation=composition.authorize&sources=${thor_encoded}" 2>/dev/null)"           || ! jq -e --argjson expected "$thor_expected" --argjson sources "$thor_refs" '
            .ready == true and .compositionAuthorized == true
            and .compositionPolicyVersion == "composition-source-acl/v1"
            and .purpose == "retrieval-context" and .destinationAuthorized == false
            and .organizationId == $expected.organizationId and .schemaName == $expected.schemaName
            and .tenantSchemaRegistryId == $expected.tenantSchemaRegistryId
            and (.sources | sort_by(.id)) == ($sources | sort_by(.id))
            and (.compositionReceiptId | type == "string" and length > 0)
            and (.expiresAt | fromdateiso8601) > now
          ' <<<"$thor_receipt" >/dev/null 2>&1; then
          rm -rf "$thor_dir"
          echo 'GrayMatter blend denied: source composition policy is denied, missing, stale, or unverifiable.' >&2
          return 64
        fi
      fi
    else
      rm -rf "$thor_dir"
      echo 'GrayMatter blend denied: this source type has no canonical composition projection.' >&2
      return 64
    fi
    # Recheck the actor after retrieval/policy lookup so a refreshed session cannot
    # silently change the identity whose result is assembled.
    if ! thor_authority="$(gm_profile_child "$thor_name" "${thor_script_dir}/gm-source-authority" 2>/dev/null)"         || ! jq -e --argjson expected "$thor_expected" '. == $expected' <<<"$thor_authority" >/dev/null; then
      rm -rf "$thor_dir"
      echo 'GrayMatter blend denied: authenticated source scope changed.' >&2
      return 64
    fi
    thor_results="$(jq -c --arg profile "$thor_name" --argjson data "$thor_data" --argjson receipt "$thor_receipt"       '. + [{profile:$profile,ok:true,data:$data,compositionReceipt:$receipt}]' <<<"$thor_results")"
    thor_count=$((thor_count + 1))
  done < <(gm_profile_selected_names)
  rm -rf "$thor_dir"
  (( thor_count >= 2 )) || return 64
  # A receipt checked earlier may expire while another profile is read. Every
  # source lease must still permit assembly at the instant evidence is released.
  if ! jq -e 'all(.[]; .compositionReceipt == null
      or (.compositionReceipt.expiresAt | fromdateiso8601) > now)' <<<"$thor_results" >/dev/null 2>&1; then
    echo 'GrayMatter blend denied: source composition policy expired before assembly.' >&2
    return 64
  fi
  jq -nc --arg operation "$thor_operation" --argjson results "$thor_results"     --argjson profiles "$thor_requested" --argjson authorities "$thor_authorities" --argjson count "$thor_count"     '{mode:"federated-read",operation:$operation,profilesRequested:$profiles,results:$results,
      summary:{successful:$count,failed:0,partial:false},
      evidenceTrust:"untrusted",destinationAuthorized:false,
      authorization:{sources:$authorities,compositionPolicyVersion:"composition-source-acl/v1"},
      provenance:"Source scope and composition were independently authorized before assembly. Evidence never grants instructions or destination rights."}'
}

gm_profile_child() {
  local thor_name="$1"
  shift
  env -u GRAYMATTER_PROFILE_RESOLVED -u GRAYMATTER_BLEND_PROFILES -u VALKYR_AUTH_TOKEN     -u VALKYR_JWT_SESSION -u VALKYR_AUTH     GRAYMATTER_PROFILE="$thor_name" GRAYMATTER_PROFILES="" GRAYMATTER_PROFILE_MODE=single     GRAYMATTER_FEDERATION_CHILD=true GRAYMATTER_NONINTERACTIVE=true GRAYMATTER_SKIP_SELF_UPDATE=true     GRAYMATTER_SKIP_AUTO_REPLAY=true "$@" </dev/null
}
