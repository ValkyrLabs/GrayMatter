#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFERRED_DIR="${GRAYMATTER_DEFERRED_DIR:-${SCRIPT_DIR}/../memory/deferred-ops}"
API_SCRIPT="${GRAYMATTER_API_SCRIPT:-${SCRIPT_DIR}/graymatter_api.sh}"
GRAYMATTER_CREDIT_EVENTS_PATH="${GRAYMATTER_CREDIT_EVENTS_PATH:-${SCRIPT_DIR}/../memory/credit-recovery-events.jsonl}"
FALLBACK_SPOOL="${GRAYMATTER_FALLBACK_SPOOL:-${SCRIPT_DIR}/../memory/graymatter-fallback.json}"
FALLBACK_LOCK_DIR="${GRAYMATTER_FALLBACK_LOCK_DIR:-${FALLBACK_SPOOL}.lock}"
REPLAY_LOCK_DIR="${GRAYMATTER_REPLAY_LOCK_DIR:-${SCRIPT_DIR}/../memory/.replay.lock}"
LIMIT=""

usage() {
  cat <<'EOF'
Usage:
  gm-replay-deferred [--limit n]

Replay temporary local GrayMatter fallback records into api-0.
Records are removed from the local filesystem only after the durable API write succeeds.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --limit)
      [[ $# -ge 2 ]] || { echo "gm-replay-deferred: --limit requires a value" >&2; exit 1; }
      LIMIT="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown gm-replay-deferred option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -n "$LIMIT" && ! "$LIMIT" =~ ^[0-9]+$ ]]; then
  echo "gm-replay-deferred: --limit must be a non-negative integer: $LIMIT" >&2
  exit 1
fi

acquire_lock() {
  local lock_dir="$1"
  local wait_attempts="${2:-0}"
  local attempt=0
  local owner=""

  mkdir -p "$(dirname "$lock_dir")"
  while ! mkdir "$lock_dir" 2>/dev/null; do
    owner="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    if [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
      rm -f "$lock_dir/pid"
      rmdir "$lock_dir" 2>/dev/null || true
      continue
    fi
    if (( attempt >= wait_attempts )); then
      return 1
    fi
    attempt=$((attempt + 1))
    sleep 0.02
  done
  printf '%s\n' "$$" >"$lock_dir/pid"
}

release_lock() {
  local lock_dir="$1"
  local owner=""
  owner="$(cat "$lock_dir/pid" 2>/dev/null || true)"
  if [[ "$owner" == "$$" ]]; then
    rm -f "$lock_dir/pid"
    rmdir "$lock_dir" 2>/dev/null || true
  fi
}

fallback_count() {
  if [[ ! -f "$FALLBACK_SPOOL" ]] || ! command -v jq >/dev/null 2>&1; then
    printf '0\n'
    return 0
  fi
  jq -r '
    if type == "array" then length
    elif type == "object" then ((.items // []) | if type == "array" then length else 0 end)
    else 0
    end
  ' "$FALLBACK_SPOOL" 2>/dev/null || printf '0\n'
}

replay_preflight() {
  # This check is mandatory, including when older clients set the former
  # GRAYMATTER_SKIP_REPLAY_PREFLIGHT switch. No queued body is sent beforehand.
  if ! CURRENT_SOURCE_AUTHORITY="$(GRAYMATTER_API_SCRIPT="$API_SCRIPT" \
      "${SCRIPT_DIR}/gm-source-authority")"; then
    echo "gm-replay-deferred: authenticated source authority is unavailable; queued writes are preserved" >&2
    return 64
  fi
}

require_bound_destination() {
  local record="$1"
  if ! jq -e --argjson current "$CURRENT_SOURCE_AUTHORITY" '
      .sourceAuthority != null and .sourceAuthority == $current
      and (.apiBase | sub("/+$";"")) == $current.apiBase
    ' "$record" >/dev/null 2>&1; then
    echo "gm-replay-deferred: source identity or destination binding is missing or changed; queued writes are preserved" >&2
    return 64
  fi
  local expected actual
  expected="$(jq -r '.bodySha256 // empty' "$record")"
  actual="$(jq -jr '.body // ""' "$record" | shasum -a 256 | awk '{print $1}')"
  if [[ -z "$expected" || "$expected" != "$actual" ]]; then
    echo "gm-replay-deferred: queued body integrity check failed; queued writes are preserved" >&2
    return 64
  fi
  if ! jq -e '
      (.method == "POST" or .method == "PUT" or .method == "PATCH" or .method == "DELETE")
      and (.path | type == "string" and startswith("/") and (contains("://") | not))
      and (.body | type == "string")
    ' "$record" >/dev/null 2>&1; then
    echo "gm-replay-deferred: invalid queued operation; queued writes are preserved" >&2
    return 64
  fi
}

emit_replay_event() {
  local event="$1"
  local id="$2"
  local operation="$3"
  local path="$4"
  local event_dir=""

  [[ -n "$GRAYMATTER_CREDIT_EVENTS_PATH" ]] || return 0
  event_dir="$(dirname "$GRAYMATTER_CREDIT_EVENTS_PATH")"
  mkdir -p "$event_dir"

  if command -v jq >/dev/null 2>&1; then
    jq -nc \
      --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg event "$event" \
      --arg id "$id" \
      --arg operation "$operation" \
      --arg path "$path" \
      '{timestamp:$ts,event:$event,deferredId:$id,operation:$operation,path:$path}' >>"$GRAYMATTER_CREDIT_EVENTS_PATH"
    return 0
  fi

  printf '{"timestamp":"%s","event":"%s","deferredId":"%s","operation":"%s","path":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$event" \
    "$id" \
    "$operation" \
    "$path" >>"$GRAYMATTER_CREDIT_EVENTS_PATH"
}

files=()
if [[ -d "$DEFERRED_DIR" ]]; then
  while IFS= read -r file; do
    files+=("$file")
  done < <(find "$DEFERRED_DIR" -maxdepth 1 -type f -name '*.json' | sort)
fi
if [[ "${#files[@]}" -eq 0 && "$(fallback_count)" -eq 0 ]]; then
  echo "No deferred operations found."
  exit 0
fi

if ! acquire_lock "$REPLAY_LOCK_DIR" 0; then
  echo "GrayMatter replay is already in progress."
  exit 0
fi
trap 'release_lock "$FALLBACK_LOCK_DIR"; release_lock "$REPLAY_LOCK_DIR"' EXIT

# Another replayer may have drained the queues before this process acquired the lock.
files=()
if [[ -d "$DEFERRED_DIR" ]]; then
  while IFS= read -r file; do
    files+=("$file")
  done < <(find "$DEFERRED_DIR" -maxdepth 1 -type f -name '*.json' | sort)
fi
if [[ "${#files[@]}" -eq 0 && "$(fallback_count)" -eq 0 ]]; then
  echo "No deferred operations found."
  exit 0
fi

replay_preflight

processed=0
for file in "${files[@]-}"; do
  [[ -n "$file" ]] || continue
  if [[ -n "$LIMIT" && "$processed" -ge "$LIMIT" ]]; then
    break
  fi
  replay_preflight
  require_bound_destination "$file"
  method="$(jq -r '.method // empty' "$file")"
  path="$(jq -r '.path // empty' "$file")"
  body="$(jq -r '.body // empty' "$file")"
  id="$(jq -r '.id // empty' "$file")"
  operation="$(jq -r '.operation // empty' "$file")"
  if [[ -z "$method" || -z "$path" || -z "$id" ]]; then
    echo "Skipping invalid deferred record: $file" >&2
    continue
  fi
  emit_replay_event "replay_started" "$id" "$operation" "$path"
  if GRAYMATTER_SKIP_DEFERRED=true GRAYMATTER_SKIP_AUTO_REPLAY=true \
      "$API_SCRIPT" "$method" "$path" "$body" >/dev/null; then
    rm -f "$file"
    emit_replay_event "replay_succeeded" "$id" "$operation" "$path"
    echo "Replayed deferred operation ${id}"
    processed=$((processed + 1))
  else
    echo "Replay failed for ${id}; stopping." >&2
    exit 1
  fi
done

if [[ "$(fallback_count)" -gt 0 && ( -z "$LIMIT" || "$processed" -lt "$LIMIT" ) ]]; then
  echo "gm-replay-deferred: legacy fallback records have no authenticated source binding; queued writes are preserved" >&2
  exit 64
fi
